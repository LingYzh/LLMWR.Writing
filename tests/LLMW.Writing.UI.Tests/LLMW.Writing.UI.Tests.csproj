<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>LLMW.Writing.UI.Tests</AssemblyName>
    <RootNamespace>LLMW.Writing.UI.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <UseWinUI>false</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

    <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="..\..\src\LLMW.Writing.Contracts\LLMW.Writing.Contracts.csproj" />
    <Compile Include="..\..\src\LLMW.Writing.UI\DistributionLayout.cs" Link="LinkedUI\DistributionLayout.cs" />
    <Compile Include="..\..\src\LLMW.Writing.UI\WebView\**\*.cs" Link="LinkedWebView\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\LLMW.Writing.UI\Hosting\WebViewProcessFailedKindMapper.cs" Link="LinkedHosting\WebViewProcessFailedKindMapper.cs" />
    <Content Include="..\..\src\web-editor\app\**\*">
      <Link>web-editor\app\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
