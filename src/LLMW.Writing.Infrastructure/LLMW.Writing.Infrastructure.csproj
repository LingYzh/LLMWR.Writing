<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LLMW.Writing.Infrastructure</AssemblyName>
    <RootNamespace>LLMW.Writing.Infrastructure</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="LibGit2Sharp.NativeBinaries" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package is referenced only here. These are propagated as project content to the
         Core composition root and test executables; no renderer/UI project references native Git. -->
    <Content Include="$(NuGetPackageRoot)\libgit2sharp.nativebinaries\2.0.324\runtimes\win-x64\native\*.dll"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Persistence\Sqlite\Migrations\0001_initial.sql"
                      LogicalName="LLMW.Writing.Infrastructure.Persistence.Sqlite.Migrations.0001_initial.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LLMW.Writing.Application\LLMW.Writing.Application.csproj" />
    <ProjectReference Include="..\LLMW.Writing.Contracts\LLMW.Writing.Contracts.csproj" />
    <ProjectReference Include="..\LLMW.Writing.Domain\LLMW.Writing.Domain.csproj" />
  </ItemGroup>
</Project>
