<Window
    x:Class="LLMW.Writing.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
            <TextBox x:Name="ProjectPathBox" Width="220" PlaceholderText="project folder" />
            <Button x:Name="OpenProjectButton" Content="Open project" Click="OnOpenProjectClick" />
            <TextBox x:Name="ChapterIdBox" Width="220" PlaceholderText="chapter id" />
            <TextBox x:Name="DraftFileBox" Width="140" PlaceholderText="chapter.md" />
            <Button x:Name="OpenDraftButton" Content="Open draft" Click="OnOpenDraftClick" />
            <Button x:Name="SaveButton" Content="Save" Click="OnSaveClick" />
            <Button x:Name="RestoreButton" Content="Restore" Click="OnRestoreClick" />
            <Button x:Name="DiscardButton" Content="Discard" Click="OnDiscardClick" />
        </StackPanel>
        <Grid x:Name="RendererHost" Grid.Row="1">
            <WebView2 x:Name="RendererView" />
        </Grid>
        <TextBlock
            x:Name="NativeStatus"
            Grid.Row="1"
            Margin="16"
            VerticalAlignment="Bottom"
            TextWrapping="Wrap" />
    </Grid>
</Window>
